# 复制为 .env 并填入真实值（.env 不要提交 git）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

APP_ENV=development
LOG_LEVEL=INFO

# 微信小程序配置（复制为 .env 后填入真实值；AppSecret 绝不提交、绝不进前端）
WECHAT_APPID=your_wechat_appid_here
WECHAT_APPSECRET=your_wechat_appsecret_here

# MySQL 配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=ai_learn
MYSQL_CHARSET=utf8mb4
MYSQL_POOL_MINSIZE=1
MYSQL_POOL_MAXSIZE=10
MYSQL_AUTO_INIT=true

# JWT 鉴权（复制为 .env 后填入随机长字符串，如 python -c "import secrets; print(secrets.token_hex(32))"）
JWT_SECRET=your-jwt-secret-at-least-32-bytes
JWT_EXPIRE_DAYS=30

# Tavily 联网搜索/网页抽取配置（用于 AI 出题接地，获取最新知识）
# 复制为 .env 后填入真实值；未配置 TAVILY_API_KEY 或 ENABLE_WEB_SEARCH=false 时自动降级为“未接地”出题
TAVILY_API_KEY=your_tavily_api_key
ENABLE_WEB_SEARCH=true
# 以下为可选调优项，不填则用代码默认值
# TAVILY_SEARCH_BRIEF_MAX_RESULTS=5
# TAVILY_SEARCH_FULL_MAX_RESULTS=3
# TAVILY_SEARCH_FULL_DEPTH=advanced
# TAVILY_EXTRACT_DEPTH=advanced
# TAVILY_EXTRACT_FORMAT=markdown
# TAVILY_COUNTRY=
# QUIZ_AGENT_TOOL_CALL_LIMIT=10
# QUIZ_AGENT_RECURSION_LIMIT=30
# QUIZ_DIGEST_MAX_CHARS=2000
# ===== 私有知识库 / 百炼 Embedding（复制为 .env 后填入真实值）=====
# 百炼 API Key（阿里云百炼控制台获取）；未填写时知识库上传/建库不可用
DASHSCOPE_API_KEY=your-dashscope-api-key-here
# 百炼 OpenAI 兼容接口地址
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Embedding 模型与维度（维度建库后不可变；变更需清空向量目录重建）
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=8
EMBEDDING_TIMEOUT=30
EMBEDDING_MAX_RETRIES=2

# 知识库功能开关
ENABLE_KNOWLEDGE_BASE=true
# Chroma 本地持久化目录与上传文件目录（相对 backend/，也可写绝对路径）
CHROMA_PERSIST_DIR=data/chroma
KB_UPLOAD_DIR=data/knowledge_base
# 单文件大小上限（MB）、单文档最大分块数
KB_MAX_FILE_MB=10
KB_MAX_CHUNKS_PER_DOC=2000
# 文本分块参数
KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=100
# 检索返回分块数与建库并发
KB_RETRIEVAL_TOP_K=4
KB_INGESTION_CONCURRENCY=2
