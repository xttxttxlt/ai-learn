# 复制为 .env 并填入真实值（.env 不要提交 git）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

APP_ENV=development
LOG_LEVEL=INFO

# 微信小程序配置（复制为 .env 后填入真实值；AppSecret 绝不提交、绝不进前端）
WECHAT_APPID=your_wechat_appid_here
WECHAT_APPSECRET=your_wechat_appsecret_here

# MySQL 配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=ai_learn
MYSQL_CHARSET=utf8mb4
MYSQL_POOL_MINSIZE=1
MYSQL_POOL_MAXSIZE=10
MYSQL_AUTO_INIT=true
# JWT 鉴权（复制为 .env 后填入随机长字符串，如 python -c "import secrets; print(secrets.token_hex(32))"）
JWT_SECRET=your-jwt-secret-at-least-32-bytes
JWT_EXPIRE_DAYS=30
